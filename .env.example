# Copy to .env on the Pi and adjust.

# bme280 | htu21 | dht22
SENSOR=bme280

# Device node passed into the container:
#   I2C sensors (bme280, htu21): /dev/i2c-1
#   dht22:                       /dev/gpiochip0
SENSOR_DEVICE=/dev/i2c-1

# Optional, defaults shown
#RUN_INTERVAL_SECONDS=60
#METRICS_PORT=8000
#EXPORT_CPU_TEMPERATURE=true
#LOG_LEVEL=INFO

# I2C sensors. Default address: bme280 0x76 (some boards use 0x77), htu21 0x40
#I2C_BUS=1
#I2C_ADDRESS=0x76

# dht22. GPIO_PIN is the BCM GPIO number (not the physical header pin).
# GPIO_CHIP is 0 on current Raspberry Pi OS kernels for all models (older Pi 5
# kernels used 4, in which case also set SENSOR_DEVICE=/dev/gpiochip4).
#GPIO_CHIP=0
#GPIO_PIN=4

# Optional MQTT publishing (plain MQTT, no TLS: use on a trusted network).
# Enabled when MQTT_HOST is set.
#MQTT_HOST=mqtt.example.lan
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
# Unique per Pi, used in topics and Home Assistant IDs. Letters, digits, _ and -.
#MQTT_DEVICE_ID=livingroom-pi
#MQTT_DEVICE_NAME=Living room
#MQTT_TOPIC_PREFIX=sensor-pi-to-prom
#MQTT_HA_DISCOVERY=true
#MQTT_DISCOVERY_PREFIX=homeassistant
